# Arc Strength local/development settings. Do not store passwords here.
ARC_ENV=development
ARC_INSTANCE_PATH=instance
ARC_DATABASE_PATH=instance/arc-strength.sqlite3
ARC_TRUSTED_HOSTS=localhost,127.0.0.1
ARC_SECURE_COOKIES=0
ARC_PROXY_COUNT=0
ARC_SESSION_HOURS=12
# Temporary student/test portal account; set to 0 when real student accounts are provisioned.
ARC_ENABLE_TEST_STUDENT=1
ARC_WORKERS=2
ARC_THREADS=4
LISTEN_ADDRESS=127.0.0.1:8000

# Production one-click updates default to the official repository and main branch.
# Only root should be able to edit these values in /etc/arc-strength.env.
ARC_UPDATE_REPOSITORY=https://github.com/snezat/Eagle_PE.git
ARC_UPDATE_BRANCH=main
