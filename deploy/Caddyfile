# Replace the hostname before enabling. Caddy obtains and renews HTTPS certificates.
# For a LAN-only hostname, add `tls internal` inside the site block and install
# Caddy's local CA certificate on every coach/weight-room device.
strength.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
    header {
        -Server
    }
    request_body {
        max_size 8MB
    }
}
